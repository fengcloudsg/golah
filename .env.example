GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key
ADMIN_PIN=golah-admin
PORT=4174
HOST=0.0.0.0
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
# Let's Encrypt (or win-acme) files — required for HTTPS on 443
SSL_CERT_PATH=certs/fullchain.pem
SSL_KEY_PATH=certs/privkey.pem
# SSL_CA_PATH=certs/chain.pem
# Optional: Google AdSense publisher id for web ads
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key
# Empty for same-origin web. Cloud Run URL when building Play/App Store apps.
VITE_API_BASE=
POSTAL_MAP_PATH=data/postal-map.json
# Web Push (optional — keys are auto-generated into data/vapid.json if omitted)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:golah@localhost
# Optional: Firebase Cloud Messaging server key for Android/iOS remote push
FCM_SERVER_KEY=
# OTP email (optional — without SMTP the code is logged in the API console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GoLah! <noreply@example.com>
# SMTP_SECURE=1
